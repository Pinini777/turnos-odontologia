{
  "name": "turnos-odontologia",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "db:migrar": "node --env-file-if-exists=.env --import tsx src/shared/persistencia/migrar-cli.ts",
    "test": "vitest run && npm test -w web",
    "typecheck": "tsc && npm run typecheck -w web",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "fastify": "5.12.8",
    "jose": "6.2.18",
    "nodemailer": "10.6.1",
    "postgres": "3.4.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "3.2.7"
  }
}
