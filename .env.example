# Copia este archivo a .env si necesitas cambiar algo. Todos los valores son FALSOS (RN-DA-02).
# Los tests no necesitan .env.

# Persistencia PostgreSQL opcional (cadenas del Session pooler).
DATABASE_URL=
TEST_DATABASE_URL=

PORT=3000
APP_TZ=America/Argentina/Mendoza

# Sesiones (C-04)
JWT_SECRET=cambiar-en-local

# Email (C-06). En tests se usa el outbox en memoria.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=usuario-ejemplo
SMTP_PASS=clave-ejemplo
MAIL_FROM=turnos@example.com

# Contrasenas de ejemplo de los usuarios semilla (src/shared/seed.ts guarda solo su hash bcrypt):
#   profesional@example.com y profesional2@example.com -> profesional-ejemplo
#   recepcion@example.com                              -> recepcion-ejemplo
#   paciente1@example.com                              -> paciente-ejemplo
